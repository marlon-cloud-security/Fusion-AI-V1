# ====================================================================
# FUSION-AI OFFICIAL REPOSITORY CONFIGURATION (NASA APPS)
# ====================================================================

# De-clutter Python Execution Artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
.env
.pytest_cache/
.mypy_cache/

# Isolate Transactional Databases and Local Registers
database/*.db
database/fusion_records.db
*.db
*.sqlite
*.sqlite3

# Isolate Raw Binary Captures & Network Dumps (Root + Subdirectories)
*.cap
*.csv
*.kismet
*.kismet.*
*.netxml
*.log

# Isolate Bulk Tool Output Frameworks
outputs/soar_snapshots/
outputs/sqlmap_out/
outputs/json/
outputs/logs/

# General Wildcard Protection Inside Outputs
outputs/*.json
outputs/*.jsonl
outputs/*.txt
outputs/*.bak

# CRITICAL POLICY: Preserve User Interface Dashboards & Frontends
!outputs/fusion_neon_dashboard.html
!outputs/matrix_live.html
